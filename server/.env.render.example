# ========================================================
# RENDER DEPLOYMENT - ENVIRONMENT VARIABLES
# Add these in your Render Dashboard: Web Service -> Environment
# ========================================================

# General Configuration (Render sets PORT automatically, defaults to 10000)
NODE_ENV=production
PORT=10000

# CORS Configuration (Set to * for open access or your client domain)
CORS_ORIGIN=*

# Cryptographic Tokens (Render generates these automatically if using render.yaml)
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_string_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Databases (Optional: If omitted, backend runs in zero-dependency standalone mode with disk persistence)
# PostgreSQL (e.g. Supabase, Neon, AWS RDS, or Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/mala_prod?schema=public&sslmode=prefer

# MongoDB Atlas (e.g. cluster0.mongodb.net):
# MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/mala_db?retryWrites=true&w=majority

